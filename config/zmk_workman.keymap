#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
  behaviors {

    /* LEFT-hand cross-hand HRMs */
    lhm: left_hand_hrm {
      compatible = "zmk,behavior-hold-tap";
      label = "LHM";
      #binding-cells = <2>;
      tapping-term-ms = <200>;
      quick-tap-ms = <0>;
      flavor = "tap-unless-interrupted";
      bindings = <&kp>, <&kp>;

      /* RIGHT side key positions */
      hold-trigger-key-positions = <5 6 7 8 9  15 16 17 18 19  25 26 27 28 29  33 34 35>;
    };

    /* RIGHT-hand cross-hand HRMs */
    rhm: right_hand_hrm {
      compatible = "zmk,behavior-hold-tap";
      label = "RHM";
      #binding-cells = <2>;
      tapping-term-ms = <200>;
      quick-tap-ms = <0>;
      flavor = "tap-unless-interrupted";
      bindings = <&kp>, <&kp>;

      /* LEFT side key positions */
      hold-trigger-key-positions = <0 1 2 3 4  10 11 12 13 14  20 21 22 23 24  30 31 32>;
    };
  };
  
  / {
  combos {
    compatible = "zmk,combos";

    /* ---------- LEFT (opening) ---------- */

    combo_lparen {
      timeout-ms = <40>;
      key-positions = <11 12>;   // S + H
      bindings = <&kp LPAR>;
    };

    combo_lbracket {
      timeout-ms = <40>;
      key-positions = <12 13>;   // H + T
      bindings = <&kp LBKT>;
    };

    combo_lbrace {
      timeout-ms = <40>;
      key-positions = <11 13>;   // S + T
      bindings = <&kp LBRC>;
    };

    /* ---------- RIGHT (closing) ---------- */

    combo_rparen {
      timeout-ms = <40>;
      key-positions = <16 17>;   // N + E
      bindings = <&kp RPAR>;
    };

    combo_rbracket {
      timeout-ms = <40>;
      key-positions = <17 18>;   // E + O
      bindings = <&kp RBKT>;
    };

    combo_rbrace {
      timeout-ms = <40>;
      key-positions = <16 18>;   // N + O
      bindings = <&kp RBRC>;
    };
  };
};

  keymap {
    compatible = "zmk,keymap";

    /* =========================
     * LAYER 0 — WORKMAN BASE
     * ========================= */
    base {
      display-name = "BASE";
      bindings = <
        /* Row 1 */
        &kp Q    &kp D    &kp R    &kp W    &kp B      &kp J    &kp F    &kp U    &kp P    &kp SQT

        /* Row 2 (final HRM logic) */
        &kp A          &lhm LALT S    &lhm LSHFT H    &lhm LCTRL T    &kp G
        &kp Y          &rhm RCTRL N   &rhm RSHFT E    &rhm RALT O     &kp I

        /* Row 3 */
        &kp Z    &kp X    &kp M    &kp C    &kp V      &kp K    &kp L    &kp COMMA &kp DOT  &kp FSLH

        /* Thumbs */
        &lt 3 BSPC   &kp TAB   &lt 1 CLCK      &lt 2 PSCRN   &kp ENTER   &lt 4 SPACE
      >;
    };

    /* =========================
     * LAYER 1 — NUM
     * ========================= */
    layer_1 {
      display-name = "L1";
      bindings = <
        /* Row 1 */
        &kp LBKT  &kp N7   &kp N8   &kp N9   &kp RBKT    &none &none &none &none &none

        /* Row 2 */
        &none      &lhm LALT N4   &lhm LSHFT N5   &lhm LCTRL N6   &kp EQUAL
        &none      &rhm RCTRL N   &rhm RSHFT E    &rhm RALT O     &none

        /* Row 3 */
        &kp GRAVE  &kp N1   &kp N2   &kp N3   &kp BSLH    &none &none &none &none &none

        /* Thumbs */
        &kp N0   &kp MINUS   &none   &trans   &trans   &trans
      >;
    };

    /* =========================
     * LAYER 2 — SYMBOLS
     * ========================= */
    layer_2 {
      display-name = "L2";
      bindings = <
        /* Row 1 */
        &kp LBRC  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RBRC     &none &none &none &none &none

        /* Row 2 (full symmetry applied) */
        &kp COLON  &lhm LALT DLLR   &kp PRCNT   &lhm LCTRL CARET   &kp PLUS
        &kp Y      &rhm RCTRL N     &rhm RSHFT E  &rhm RALT O       &kp I

        /* Row 3 */
        &kp TILDE &kp EXCL &kp AT &kp HASH &kp PIPE     &none &none &none &none &none

        /* Thumbs */
        &kp RPAR   &kp UNDERSCORE   &none   &trans   &trans   &trans
      >;
    };

    /* (Layers 3–4 unchanged — omitted for brevity if you already have them) */
  };
};