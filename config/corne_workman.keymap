#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        /* LEFT-hand cross-hand HRMs */
        lhm: left_hand_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "LHM";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-unless-interrupted";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 18 19 20 21 22 30 31 32 33 34>;
        };

        /* RIGHT-hand cross-hand HRMs */
        rhm: right_hand_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "RHM";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-unless-interrupted";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 24 25 26 27 28>;
        };
    };

    combos {
        compatible = "zmk,combos";
        /* LEFT (open) */
        combo_lparen { timeout-ms = <40>; key-positions = <13 14>; bindings = <&kp LPAR>; };
        combo_lbracket { timeout-ms = <40>; key-positions = <14 15>; bindings = <&kp LBKT>; };
        combo_lbrace { timeout-ms = <40>; key-positions = <13 15>; bindings = <&kp LBRC>; };
        /* RIGHT (close) */
        combo_rparen { timeout-ms = <40>; key-positions = <18 19>; bindings = <&kp RPAR>; };
        combo_rbracket { timeout-ms = <40>; key-positions = <19 20>; bindings = <&kp RBKT>; };
        combo_rbrace { timeout-ms = <40>; key-positions = <18 20>; bindings = <&kp RBRC>; };
    };

        keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "WORKMAN";
            bindings = <
                &none &kp Q &kp W &kp D &kp R &kp B            &kp J &kp F &kp U &kp P &kp SQT &none
                &none &kp A &lhm LALT S &lhm LSHFT H &lhm LCTRL T &kp G     &kp Y &rhm RCTRL N &rhm RSHFT E &rhm RALT O &kp I &none
                &none &kp Z &kp X &kp C &kp V &kp M            &kp K &kp L &kp COMMA &kp DOT &kp FSLH &none
                                &lt 3 BSPC &kp TAB &lt 1 CLCK  &lt 2 PSCRN &kp ENTER &lt 4 SPACE
            >;
        };

        layer_1 {
            display-name = "NUM";
            bindings = <
                &none &kp LBKT &kp N7 &kp N8 &kp N9 &kp RBKT   &none &none &none &none &none &none
                &none &none &lhm LALT N4 &lhm LSHFT N5 &lhm LCTRL N6 &kp EQUAL  &none &none &none &none &none &none
                &none &kp GRAVE &kp N1 &kp N2 &kp N3 &kp BSLH  &none &none &none &none &none &none
                                &trans &trans &trans           &kp N0 &kp MINUS &trans
            >;
        };

        layer_2 {
            display-name = "SYS";
            bindings = <
                &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &none &none &none &none &none
                &none &none        &none        &none        &none        &none          &none &none &none &none &none &none
                &none &none        &none        &bt BT_CLR   &none        &bootloader    &none &none &none &none &none &none
                                &trans &trans &trans           &trans &trans &trans
            >;
        };

        layer_3 {
            display-name = "NAV";
            bindings = <
                &none &none &none &none &none &none            &none &kp HOME &kp UP   &kp END   &kp PG_UP &none
                &none &none &none &none &none &none            &none &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &none
                &none &none &none &none &none &none            &none &none    &none    &none     &none     &none
                                &trans &trans &trans           &trans &trans &trans
            >;
        };

        layer_4 {
            display-name = "MEDIA";
            bindings = <
                &none &none &none &none &none &none            &none &none &none &none &none &none
                &none &none &none &none &none &none            &none &kp C_PREV &kp C_PP &kp C_NEXT &none &none
                &none &none &none &none &none &none            &none &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &none &none
                                &trans &trans &trans           &trans &trans &trans
            >;
        };
    };
};
